#!/bin/bash
# Baton Mi 语音「重复订阅」自愈守卫 —— 检测到 BLE 音频通知被重复投递就重启 mi-remote。
#
# 为什么要它（本机 2026-10-13 实测结论）：
#   mi-remote 每经历一次 BLE 重连，音频 notify 就会**多出一层订阅**；同一帧音频被
#   解码 N 次，喂给云端 ASR 的 PCM 被拉长为实际录音的 N 倍。ADPCM 解码器被喂重复
#   字节后预测器「顶轨」，波形变成 峰值 32768 + 大直流偏置 + 低频能量占大头，
#   识别结果从偶发乱码一路恶化到几乎全错。倍数随进程存活期间的重连次数累积增长。
#
#   判据（日志里最可靠的指纹）：
#     正常一次录音恰好一次「音频流开始」；被重复订阅时是 N 次（N = 倍数）。
#     实测 1 次 → 解码/实际 ≈ 0.93（正常）；2 次 → 1.96；3 次 → 2.97；4~5 次 → 4.4~4.9。
#   处置：命中即重启 mi-remote.service（重启后订阅回到 1，已实测恢复正常）。
#
# 策略：
#   · 常驻轮询（默认 20s），只看**新增**日志（用游标避免重复命中同一条）；
#   · 只统计**已完成**的录音会话：一次会话内「音频流开始」≥ 2 即判为坏；
#   · 命中后重启并进入冷却（默认 300s），避免抖动风暴；
#   · 平常完全不动作，也不碰按键/蓝牙链路。
#
# 为什么不用「定期无脑重启」：语音会话可能正在进行，无脑重启会打断；
# 这个守卫平时什么都不做，只在真的踩到重复订阅时才出手。
#
# 用法：
#   baton-asr-guard           常驻（systemd 用户服务）
#   baton-asr-guard --once    只跑一轮（手动排障；返回 0=健康，1=刚自愈，2=读取失败）
set -uo pipefail

UNIT="${BATON_ASR_UNIT:-mi-remote.service}"
INTERVAL="${BATON_ASR_INTERVAL:-20}"        # 轮询间隔（秒）
COOLDOWN="${BATON_ASR_COOLDOWN:-300}"       # 重启冷却（秒）
CURSOR="${BATON_ASR_CURSOR:-$HOME/.local/state/baton-asr-guard.cursor}"
FIRST_LOOKBACK="${BATON_ASR_FIRST_LOOKBACK:--2min}"

ONCE=0
[ "${1:-}" = "--once" ] && ONCE=1

log() { echo "[$(date +%H:%M:%S)] $*"; }

mkdir -p "$(dirname "$CURSOR")"

# 一轮检查；返回 0=健康 / 1=命中并已自愈 / 3=无新日志
check_once() {
  local since_arg out max_starts newest
  if [ -s "$CURSOR" ]; then
    since_arg="--since=$(cat "$CURSOR")"
  else
    since_arg="--since=$FIRST_LOOKBACK"
  fi

  out="$(journalctl --user -u "$UNIT" -o short-iso-precise --no-pager "$since_arg" 2>/dev/null)" || return 3
  [ -n "$out" ] || return 3

  # 游标推进到本次读到的**最新一行**时间戳，保证下轮只增量读新的
  newest="$(printf '%s\n' "$out" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+[+-][0-9]{2}:[0-9]{2}' | tail -1)"
  [ -n "$newest" ] && printf '%s\n' "$newest" > "$CURSOR"

  # 一次会话里「音频流开始」的最大次数（正常=1）。
  # 除了「音频流结束」，掉线/重连也要把计数清零 —— 这些行意味着上一段录音已经作废。
  # 否则一段被中断的录音（只有开始、没有结束，见 2026-10-16 故障）会把下一次正常
  # 的开始一起算成 2，误判成重复订阅、白重启一次正在进行的口述。
  max_starts="$(printf '%s\n' "$out" | awk '
    /音频流结束|BLE 连接断开|连接失败|✅ 已连接遥控器/ { n = 0; next }
    /音频流开始/ { n++; if (n > m) m = n }
    END { print m + 0 }')"

  if [ "${max_starts:-0}" -ge 2 ]; then
    log "⚠️ 检出音频通知重复投递（本次会话「音频流开始」${max_starts} 次，正常应为 1）→ 重启 $UNIT"
    systemctl --user restart "$UNIT"
    return 1
  fi
  return 0
}

if [ "$ONCE" = 1 ]; then
  check_once
  rc=$?
  case "$rc" in
    0) log "健康：没有重复订阅" ; exit 0 ;;
    1) log "已自愈重启" ; exit 1 ;;
    *) log "读取日志失败/无新日志" ; exit 2 ;;
  esac
fi

log "语音重复订阅守卫启动（unit=$UNIT, 间隔 ${INTERVAL}s, 冷却 ${COOLDOWN}s）"
while true; do
  check_once
  rc=$?
  if [ "$rc" = 1 ]; then
    # 刚重启过：给服务留出重连时间，并在冷却期内静默观察，避免抖动风暴
    sleep "$COOLDOWN"
    continue
  fi
  sleep "$INTERVAL"
done
