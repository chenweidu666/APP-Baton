#!/bin/bash
# Baton Mi 遥控器蓝牙看门狗 —— 遥控器睡醒/掉线后自动连回来。
#
# 为什么要它（本机实测结论）：
#   1. 遥控器休眠后 BLE 链路会掉，但它在"浅睡"时仍在广播（bluetoothctl info 的
#      RSSI 有值）；深度休眠时连广播都停（info 里连 RSSI 都没有），此时谁连都没用。
#   2. BlueZ 5.72 默认的 ReconnectUUIDs 里没有 HID(00001812)，链路丢失后 BlueZ
#      不会主动把遥控器连回来。
#   3. mi-remote 自己会重试（1~15 秒），多数情况几秒内就能连回来；但每次超时都会
#      在 BlueZ 里留下一个"挂起的连接请求"（Operation already in progress），一旦
#      卡住，之后所有连接尝试全被挡住。
#   4. 实测：停掉 mi-remote 后单独 connect 仍被挂起挡住；而"先 disconnect（取消挂起）
#      再 connect"就能连上。
#   5. 但 disconnect 会连 mi-remote **正在飞的那次连接**一起取消 —— 日志里紧跟着一条
#      br-connection-canceled，它只能重试，重试又留下新的挂起请求。两边互相打断，
#      2026-10-16 从休眠恢复后把遥控器卡死了 9 分钟（见 docs/指南.md 坑 15）。
#
# 所以看门狗只做一件真正有用的事：**发现掉线后，清掉那个挂起的连接请求再试连**，
# 让 mi-remote 随后的重试能成功。清之前先把 mi-remote 临时冻住（SIGSTOP），
# 免得它在我们清的过程中又发一个连接请求。也不默认重启蓝牙栈（要 polkit 授权、
# 且深度休眠时重启无效）。
#
# 策略：
#   · 正常时每 HEALTHY_SLEEP 秒体检，完全不打扰 mi-remote；
#   · 掉线后先给 mi-remote 宽限 GRACE 秒（它常能自己连回）；
#   · 仍掉线才出手：试连 → 若报"already in progress"则冻住 mi-remote、disconnect
#     清挂起、解冻、再连；
#   · 没连上就按 NUDGE_MIN→NUDGE_MAX 指数退避（遥控器长时间休眠时安静等待）。
#
# 关于重启蓝牙栈（默认关）：设 BATON_WD_ALLOW_RESTART=1 才启用，作为最后手段。
# 它需要 polkit 授权 —— 已随 install.sh 安装 system/49-baton-bluetooth.rules，
# 本地活动用户可免密码重启 bluetooth.service。
#
# 用法：
#   baton-bt-watchdog          常驻（systemd 用户服务）
#   baton-bt-watchdog --once   宽限+恢复跑一轮就退出（手动排障用）
set -uo pipefail

MAC="${BATON_MAC:-F0:2B:18:87:37:B7}"
VENDOR="${BATON_VENDOR:-2717}"
PRODUCT="${BATON_PRODUCT:-32b8}"
REMOTE_SVC="${BATON_REMOTE_UNIT:-mi-remote.service}"

GRACE="${BATON_WD_GRACE:-20}"
HEALTHY_SLEEP="${BATON_WD_HEALTHY_SLEEP:-8}"
NUDGE_MIN="${BATON_WD_NUDGE_MIN:-15}"
NUDGE_MAX="${BATON_WD_NUDGE_MAX:-60}"
CONNECT_TIMEOUT="${BATON_WD_CONNECT_TIMEOUT:-6}"
# 重启蓝牙栈需 polkit 授权且深度休眠时无效 → 默认关
ALLOW_RESTART="${BATON_WD_ALLOW_RESTART:-0}"
RESTART_COOLDOWN="${BATON_WD_RESTART_COOLDOWN:-300}"

ONCE=0
[ "${1:-}" = "--once" ] && ONCE=1

log() { echo "[$(date +%H:%M:%S)] $*"; }

bt_connected() { bluetoothctl info "$MAC" 2>/dev/null | grep -q "Connected: yes"; }

# 按 VID:PID 找遥控器按键节点（与托盘 / baton-bt-recover 一致）
hid_node() {
  local d v p
  for d in /sys/class/input/event*; do
    [ -r "$d/device/id/vendor" ] 2>/dev/null || continue
    v=$(cat "$d/device/id/vendor" 2>/dev/null)
    p=$(cat "$d/device/id/product" 2>/dev/null)
    if [ "$v" = "$VENDOR" ] && [ "$p" = "$PRODUCT" ]; then
      basename "$d"
      return 0
    fi
  done
  return 1
}

healthy() { bt_connected && hid_node >/dev/null; }

# 临时冻结/解冻 mi-remote —— 只在真要 disconnect 时用。
# 冻结而不是停服务：不触发它的 HID 恢复流程（那又会发一次连接请求），
# 也保住它已拿到的 /dev/input 独占句柄，几乎不产生额外的蓝牙动作。
_remote_frozen=0
freeze_remote() {
  systemctl --user kill --signal=SIGSTOP "$REMOTE_SVC" 2>/dev/null || true
  _remote_frozen=1
}
thaw_remote() {
  [ "$_remote_frozen" = 1 ] || return 0
  systemctl --user kill --signal=SIGCONT "$REMOTE_SVC" 2>/dev/null || true
  _remote_frozen=0
}
# 看门狗自己被杀掉时也要解冻，否则遥控器会一直僵在那里
trap 'thaw_remote' EXIT INT TERM

# 出手一次：清挂起 + 试连。返回 0 = 已连上
nudge() {
  local out
  bt_connected && return 0

  # 先直接试连（挂起时 BlueZ 会立刻回 already in progress）
  out=$(timeout "$CONNECT_TIMEOUT" bluetoothctl connect "$MAC" 2>&1)
  if bt_connected; then return 0; fi

  if printf '%s' "$out" | grep -qi "already in progress"; then
    # disconnect 能清掉挂起的请求，但也会把 mi-remote 正在飞的那次连接一起取消
    # （日志里紧跟着一条 br-connection-canceled），于是它重试、又留下新的挂起 ——
    # 两边互相打断，2026-10-16 实测把遥控器卡死了 9 分钟。
    # 所以先停掉 mi-remote，让它不再发新请求，清完再把它拉起来。
    log "检测到 BlueZ 挂起的连接请求 → 暂停 mi-remote、清挂起后重连"
    freeze_remote
    timeout 5 bluetoothctl disconnect "$MAC" >/dev/null 2>&1
    sleep 1
    thaw_remote
    bt_connected && return 0
    timeout "$CONNECT_TIMEOUT" bluetoothctl connect "$MAC" >/dev/null 2>&1
    bt_connected && return 0
  fi

  # 兜底（默认关）：重启蓝牙栈。需要 polkit 授权，规则见 system/49-baton-bluetooth.rules
  if [ "$ALLOW_RESTART" = 1 ] && [ $(( $(date +%s) - last_restart )) -ge "$RESTART_COOLDOWN" ]; then
    log "重启蓝牙栈（兜底）"
    systemctl --no-ask-password restart bluetooth >/dev/null 2>&1
    last_restart=$(date +%s)
    sleep 4
    timeout "$CONNECT_TIMEOUT" bluetoothctl connect "$MAC" >/dev/null 2>&1
    bt_connected && return 0
  fi
  return 1
}

last_restart=0

log "蓝牙看门狗启动（MAC=$MAC, 宽限 ${GRACE}s）"
if [ "$ONCE" = 1 ] && healthy; then
  log "一切正常，无需处理"
  exit 0
fi

delay="$NUDGE_MIN"
grace_done=0
while true; do
  if healthy; then
    delay="$NUDGE_MIN"
    grace_done=0
    sleep "$HEALTHY_SLEEP"
    continue
  fi

  # 掉线后先给 mi-remote 一个宽限窗口（只给一次）
  if [ "$grace_done" = 0 ]; then
    sleep "$GRACE"
    grace_done=1
    if healthy; then
      delay="$NUDGE_MIN"
      continue
    fi
    log "掉线超过 ${GRACE}s，出手清挂起并重连"
  fi

  if nudge; then
    log "✅ 已连上"
    delay="$NUDGE_MIN"
    grace_done=0
    [ "$ONCE" = 1 ] && exit 0
    sleep 3
    continue
  fi

  [ "$ONCE" = 1 ] && { log "❌ 未连上（遥控器可能仍在休眠，按任意键唤醒）"; exit 1; }
  log "未连上（遥控器可能休眠），${delay}s 后再试"
  sleep "$delay"
  delay=$(( delay * 2 ))
  [ "$delay" -gt "$NUDGE_MAX" ] && delay="$NUDGE_MAX"
done
